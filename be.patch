 =?UTF-8?q?=E0=B8=81=E0=B8=84=E0=B9=89=E0=B8=B2=20phone-only=20(=E0=B9=84?=
 =?UTF-8?q?=E0=B8=A1=E0=B9=88=E0=B8=A1=E0=B8=B5=20LINE)=20=E0=B9=81?=
 =?UTF-8?q?=E0=B8=81=E0=B9=89=E0=B9=82=E0=B8=9B=E0=B8=A3=E0=B9=84=E0=B8=9F?=
 =?UTF-8?q?=E0=B8=A5=E0=B9=8C=E0=B9=84=E0=B8=A1=E0=B9=88=E0=B9=84=E0=B8=94?=
